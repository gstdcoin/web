{
  "name": "gstdtoken-site",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "start:prod": "NODE_OPTIONS='--max-old-space-size=512 --max-semi-space-size=128' next start -p 3000",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build:analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next out .open-next node_modules/.cache",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "node --test scripts/*.test.cjs",
    "check:matcher": "node scripts/check-picomatch.cjs && node --test scripts/picomatch-security.cjs",
    "prebuild": "npm run check:matcher",
    "pretest": "npm run check:matcher"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.15",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.408.0",
    "next": "16.4.6",
    "next-intl": "^4.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.9",
    "glob": "14.0.6",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "wrangler": "^4.122.0",
    "picomatch": "file:vendor/picomatch"
  },
  "overrides": {
    "ws": "^8.18.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "semver": "^7.6.0",
    "tar": "^6.2.1",
    "sharp": "$sharp",
    "undici@>=7.0.0 <8.0.0": "^7.30.1",
    "postcss-selector-parser@<7.1.6": "^7.1.6",
    "picomatch": "$picomatch",
    "glob": "$glob",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "packageManager": "npm@11.13.0"
}
