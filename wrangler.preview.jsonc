{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "gstd-web-preview",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gstd-web-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "861420261114",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "workers_dev": true,
  "routes": [],
  "vars": {
    "GSTD_TRUSTED_NODE_IDS": "d8edbeee-909a-49e5-908d-922b9bf98c43"
  }
}
