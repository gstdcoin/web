# Production environment variables for low-resource VPS
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Memory optimization
NODE_OPTIONS=--max-old-space-size=256 --max-semi-space-size=64

# Next.js optimizations
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gstdtoken.net

# Disable telemetry and analytics in production
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# Port configuration
PORT=3000
HOSTNAME=0.0.0.0
